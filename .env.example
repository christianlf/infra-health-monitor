# Default timeout for network operations (seconds)
DEFAULT_TIMEOUT=5

# Number of consecutive failures before triggering alert
ALERT_THRESHOLD=3

# Database file path
DATABASE_PATH=health_monitor.db

# Alert log file path
ALERT_LOG_PATH=alerts.log

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Optional: Webhook URL for future alert notifications (not implemented yet)
# ALERT_WEBHOOK_URL=https://hooks.example.com/webhook

# Optional: Email settings for future notifications (not implemented yet)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=monitor@example.com
# SMTP_PASSWORD=your_password
# ALERT_EMAIL_TO=admin@example.com
