# Default timeout for network operations (seconds)
DEFAULT_TIMEOUT=5

# Number of consecutive failures before triggering alert
ALERT_THRESHOLD=3

# Retry logic configuration
MAX_RETRIES=3
RETRY_DELAY=1.0

# Database file path
DATABASE_PATH=health_monitor.db

# Alert log file path
ALERT_LOG_PATH=alerts.log

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Webhook URL for alert notifications (Discord, Slack, Microsoft Teams)
# Leave empty to disable webhook notifications (alerts will only go to local log)
# Discord example: https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN
# Slack example: https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Teams example: https://outlook.office.com/webhook/YOUR_WEBHOOK_URL
ALERT_WEBHOOK_URL=

# ═══════════════════════════════════════════════════════════════
# EMAIL NOTIFICATIONS (SMTP)
# ═══════════════════════════════════════════════════════════════
# Email alerts via SMTP (Gmail, Office 365, custom SMTP)
# Leave empty to disable email notifications

# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password  # Use App Password, not regular password!
# SMTP_FROM=InfraHealthMonitor <your-email@gmail.com>
# SMTP_TO=admin@example.com,team@example.com  # Comma-separated
# SMTP_USE_TLS=true

# Office 365 example:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# ═══════════════════════════════════════════════════════════════
# WEB DASHBOARD
# ═══════════════════════════════════════════════════════════════
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# ═══════════════════════════════════════════════════════════════
# PROMETHEUS METRICS
# ═══════════════════════════════════════════════════════════════
# Enable Prometheus metrics export
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ═══════════════════════════════════════════════════════════════
# MACHINE LEARNING PREDICTIONS
# ═══════════════════════════════════════════════════════════════
# ML-based failure prediction settings
ML_ENABLED=true
ML_LATENCY_THRESHOLD_PERCENT=50
ML_FAILURE_RATE_THRESHOLD=0.15
ML_PREDICTION_WINDOW_HOURS=6

# ═══════════════════════════════════════════════════════════════
# SSL CERTIFICATE MONITORING
# ═══════════════════════════════════════════════════════════════
SSL_WARNING_DAYS=30
SSL_CRITICAL_DAYS=7
